<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-image: url('/img/start_background.png'); -fx-background-size: 100% 100%;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.polimi.ingsw.Client.View.GUI.CreditsController">
    <children>
        <VBox alignment="CENTER" spacing="30.0" style="-fx-background-color: rgba(0, 0, 0, 0.75);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <Label text="C R E D I T S" textFill="#d6bb95" style="-fx-font-weight: bold; -fx-font-size: 36;"/>

                <VBox alignment="CENTER" spacing="5.0">
                    <Label text="Developed by:" textFill="white" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                    <Label text="Samuel Matta" textFill="#f9f8f5" style="-fx-font-size: 16;"/>
                    <Label text="Mattia Mareghello" textFill="#f9f8f5" style="-fx-font-size: 16;"/>
                    <Label text="Gabriele Maiolo" textFill="#f9f8f5" style="-fx-font-size: 16;"/>
                    <Label text="Francesco Monticone" textFill="#f9f8f5" style="-fx-font-size: 16;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="5.0">
                    <Label text="Music and Sound Effects:" textFill="white" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                    <Label text="Riccardo Minelli" textFill="#d6bb95" style="-fx-font-size: 16; -fx-font-style: italic;"/>
                </VBox>

                <Button mnemonicParsing="false" onAction="#onBackClicked" prefHeight="40.0" prefWidth="120.0"
                        style="-fx-background-color: #d6bb95; -fx-text-fill: #28251d; -fx-font-size: 16; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                        text="BACK" />
            </children>
        </VBox>
    </children>
</AnchorPane>